@model List<TrungTamNgoaiNgu.Models.LopHoc>
@{
    ViewData["Title"] = "Thùng rác - Lớp học";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <div class="page-title">Thùng rác — Lớp học</div>
        <div class="page-sub"><a asp-action="Index">Lớp học</a> / Thùng rác</div>
    </div>
    <a asp-action="Index" class="btn btn-outline">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> @TempData["ThanhCong"]</div>
}

<div class="card">
    <div class="table-wrap">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-trash3"></i>
                <p>Thùng rác trống</p>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tên lớp học</th>
                        <th>Khóa học</th>
                        <th>Cơ sở</th>
                        <th>Ngày xóa</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var lop = Model[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>
                                <div class="kh-name">@lop.TenLopHoc</div>
                                <div class="kh-slug">@lop.Slug</div>
                            </td>
                            <td>@(lop.KhoaHoc?.TenKhoaHoc ?? "—")</td>
                            <td>@(lop.CoSo?.TenCoSo ?? "—")</td>
                            <td>@lop.DeletedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <form method="post" asp-action="restore" asp-route-id="@lop.LopHocId"
                                      onsubmit="return confirm('Khôi phục «@lop.TenLopHoc»?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline btn-sm">
                                        <i class="bi bi-arrow-counterclockwise"></i> Khôi phục
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
