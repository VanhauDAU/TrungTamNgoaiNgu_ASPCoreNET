@model TrungTamNgoaiNgu.Models.CourseCategoryFormViewModel
@{
    ViewData["Title"] = "Thêm danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-courses.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <div class="page-title">Thêm danh mục khóa học</div>
        <div class="page-sub">Thiết lập cây phân loại để khóa học được sắp xếp rõ ràng ngay từ đầu.</div>
    </div>
    <a asp-action="Index" class="btn btn-outline">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Form.Slug" id="slugInput" />
    <input type="hidden" asp-for="Form.MaDanhMuc" id="maDanhMucHidden" />

    <div class="kh-form-grid">
        <div class="kh-col-left">
            <div class="card">
                <div class="card-header"><i class="bi bi-diagram-3"></i> Thông tin danh mục</div>
                <div class="card-body kh-stack-14">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="kh-two-col">
                        <div class="form-group">
                            <label asp-for="Form.TenDanhMuc">Tên danh mục <span class="kh-required">*</span></label>
                            <input asp-for="Form.TenDanhMuc" class="form-control" id="tenDanhMucInput"
                                   placeholder="VD: Tiếng Anh giao tiếp" />
                            <span asp-validation-for="Form.TenDanhMuc" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label>Mã danh mục</label>
                            <input class="form-control" id="maDanhMucPreviewInput"
                                   value="Sẽ tự sinh khi lưu" readonly />
                            <div class="kh-help-text">Hệ thống tự sinh mã dựa trên tên danh mục và chống trùng khi lưu.</div>
                        </div>
                    </div>

                    <div class="kh-two-col">
                        <div class="form-group">
                            <label asp-for="Form.ParentId">Danh mục cha</label>
                            <select asp-for="Form.ParentId" class="form-control">
                                <option value="">Danh mục gốc</option>
                                @foreach (var option in Model.ParentOptions)
                                {
                                    <option value="@option.DanhMucId">
                                        @option.Label@(option.IsInactive ? " (tạm ngưng)" : "")
                                    </option>
                                }
                            </select>
                            <div class="kh-help-text">Chỉ chọn khi danh mục này là nhánh con trong cây.</div>
                        </div>

                        <div class="form-group">
                            <label asp-for="Form.SortOrder">Thứ tự hiển thị</label>
                            <input asp-for="Form.SortOrder" class="form-control" type="number" min="0" />
                            <div class="kh-help-text">Số nhỏ sẽ được ưu tiên hiển thị trước.</div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Form.MoTa">Mô tả ngắn</label>
                        <textarea asp-for="Form.MoTa" class="form-control" rows="4"
                                  placeholder="Mô tả ngắn giúp admin và nhân sự hiểu danh mục này dùng để nhóm khóa học nào."></textarea>
                        <span asp-validation-for="Form.MoTa" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><i class="bi bi-toggle-on"></i> Trạng thái sử dụng</div>
                <div class="card-body kh-stack-14">
                    <div class="form-group">
                        <label asp-for="Form.TrangThai">Trạng thái</label>
                        <select asp-for="Form.TrangThai" class="form-control">
                            <option value="1">Đang hoạt động</option>
                            <option value="0">Tạm ngưng</option>
                        </select>
                    </div>
                    <div class="kh-help-text">
                        Danh mục đang hoạt động mới nên dùng để gắn khóa học đang mở. Nếu danh mục cha tạm ngưng, hệ thống sẽ chặn bật nhánh con.
                    </div>
                </div>
            </div>
        </div>

        <div class="kh-col-right">
            <div class="card">
                <div class="card-header"><i class="bi bi-link-45deg"></i> Slug và mã dự kiến</div>
                <div class="card-body kh-stack-10">
                    <code id="maDanhMucPreview" class="dm-slug-preview">DM-001</code>
                    <code id="slugPreview" class="dm-slug-preview">@Model.SlugPreview</code>
                    <div class="kh-help-text">
                        Mã và slug đều được chuẩn hóa, sinh tự động và chống trùng khi lưu.
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><i class="bi bi-lightbulb"></i> Gợi ý vận hành</div>
                <div class="card-body kh-stack-10 kh-meta">
                    <div>1. Dùng mã ngắn để tìm kiếm nhanh khi danh mục nhiều.</div>
                    <div>2. Chỉ tạo danh mục con khi thực sự cần phân nhánh.</div>
                    <div>3. Sắp xếp hợp lý sẽ giúp dropdown khóa học gọn hơn.</div>
                </div>
            </div>

            <div class="card">
                <div class="card-body kh-stack-10">
                    <button type="submit" class="btn btn-primary kh-full-btn">
                        <i class="bi bi-check-lg"></i> Lưu danh mục
                    </button>
                    <a asp-action="Index" class="btn btn-outline kh-full-btn">Hủy bỏ</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const tenDanhMucInput = document.getElementById('tenDanhMucInput');
        const slugInput = document.getElementById('slugInput');
        const slugPreview = document.getElementById('slugPreview');
        const maDanhMucHidden = document.getElementById('maDanhMucHidden');
        const maDanhMucPreview = document.getElementById('maDanhMucPreview');
        const maDanhMucPreviewInput = document.getElementById('maDanhMucPreviewInput');

        function slugify(value) {
            return (value || '')
                .trim()
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '')
                || 'danh-muc';
        }

        function syncSlugPreview() {
            const slug = slugify(tenDanhMucInput?.value || '');
            if (slugInput) slugInput.value = slug;
            if (slugPreview) slugPreview.textContent = slug;
            const parts = (tenDanhMucInput?.value || '')
                .trim()
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .replace(/[^a-z0-9\s]+/g, ' ')
                .split(/\s+/)
                .filter(Boolean);
            const token = parts.length > 1
                ? parts.map(x => x[0]).join('').toUpperCase().slice(0, 4)
                : (parts[0] || 'DM').toUpperCase().slice(0, 4);
            const code = `${token || 'DM'}-001`;
            if (maDanhMucPreview) maDanhMucPreview.textContent = code;
            if (maDanhMucPreviewInput) maDanhMucPreviewInput.value = code;
            if (maDanhMucHidden) maDanhMucHidden.value = code;
        }

        tenDanhMucInput?.addEventListener('input', syncSlugPreview);
        syncSlugPreview();
    </script>
}
