@model List<TrungTamNgoaiNgu.Models.DanhMucKhoaHoc>
@{
    ViewData["Title"] = "Thùng rác danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-courses.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <div class="page-title">Thùng rác danh mục khóa học</div>
        <div class="page-sub">@Model.Count danh mục đang nằm trong thùng rác và có thể khôi phục.</div>
    </div>
    <a asp-action="Index" class="btn btn-outline">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<div class="card">
    <div class="table-wrap">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-trash3 kh-empty-ok"></i>
                <p>Thùng rác đang trống.</p>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Danh mục</th>
                        <th>Danh mục cha</th>
                        <th>Slug</th>
                        <th>Ngày xóa</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var dm = Model[i];
                        <tr class="kh-trash-row">
                            <td class="kh-col-index">@(i + 1)</td>
                            <td>
                                <div class="kh-trash-name">@dm.TenDanhMuc</div>
                                <div class="kh-slug">@(!string.IsNullOrWhiteSpace(dm.MaDanhMuc) ? dm.MaDanhMuc : "Chưa có mã danh mục")</div>
                            </td>
                            <td>
                                @if (dm.Parent != null)
                                {
                                    <span class="badge badge-gray">@dm.Parent.TenDanhMuc</span>
                                }
                                else
                                {
                                    <span class="kh-muted">Danh mục gốc</span>
                                }
                            </td>
                            <td><code class="dm-slug">@dm.Slug</code></td>
                            <td class="kh-created">
                                @(dm.DeletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                            </td>
                            <td>
                                <form method="post" asp-action="restore" asp-route-id="@dm.DanhMucId"
                                      class="kh-inline-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="bi bi-arrow-counterclockwise"></i> Khôi phục
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
