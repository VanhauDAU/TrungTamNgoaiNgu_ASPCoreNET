@model TrungTamNgoaiNgu.Models.CoSoManagementViewModel
@{
    ViewData["Title"] = "Cơ sở đào tạo";
    ViewData["SetupSection"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-class-setup.css" asp-append-version="true" />
}

<div class="page-header setup-page-header">
    <div>
        <div class="page-title">Cơ sở đào tạo đã chuyển module</div>
        <div class="page-sub">Phần cơ sở không còn nằm trong Thiết lập lớp học. Toàn bộ CRUD, chi tiết cơ sở và phòng học đã được tách sang module riêng để dễ quản lý hơn.</div>
    </div>
    <div class="setup-header-actions">
        <a asp-controller="Campuses" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-buildings"></i> Mở module Cơ sở
        </a>
        <a asp-action="Index" class="btn btn-outline">
            <i class="bi bi-sliders"></i> Quay lại setup
        </a>
    </div>
</div>

@await Html.PartialAsync("~/Views/Admin/ClassSetup/_SetupTabs.cshtml")

<section class="setup-panel">
    <div class="setup-panel-body">
        <div class="setup-empty">
            <i class="bi bi-arrow-right-circle"></i>
            Module `Cơ sở đào tạo` hiện quản lý riêng danh sách cơ sở, phòng học theo cơ sở, nhân sự và lớp học liên quan.
        </div>
    </div>
</section>
