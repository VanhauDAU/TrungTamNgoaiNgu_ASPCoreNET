@model TrungTamNgoaiNgu.Models.LopHoc
@using TrungTamNgoaiNgu.Enums
@{
    ViewData["Title"] = "Chỉnh sửa lớp học";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var lichHocHienTai = (Model.LichHoc ?? "").Split(',', System.StringSplitOptions.RemoveEmptyEntries);

    var buocHopLe = Model.TrangThai switch
    {
        LopHocTrangThai.SapMo         => new (int val, string label, string cls)[] { (1,"Mở tuyển sinh","btn-success"), (3,"Hủy lớp","btn-danger") },
        LopHocTrangThai.DangTuyenSinh => new (int val, string label, string cls)[] { (2,"Chốt danh sách","btn-primary"), (3,"Hủy lớp","btn-danger") },
        LopHocTrangThai.ChotDanhSach  => new (int val, string label, string cls)[] { (4,"Khai giảng","btn-primary"), (3,"Hủy lớp","btn-danger") },
        LopHocTrangThai.DangHoc       => new (int val, string label, string cls)[] { (5,"Kết thúc lớp","btn-secondary") },
        _                             => Array.Empty<(int,string,string)>()
    };
}

@section Styles {
    <style>
        .class-edit-card { max-width:960px; margin:0 auto; border:1px solid #e2e8f0; border-radius:16px; overflow:hidden; box-shadow:0 16px 40px rgba(15,23,42,.08); }
        .class-edit-card .card-body { padding:2rem; background:linear-gradient(180deg,#ffffff 0%,#f8fbff 100%); }
        .form-section-title { font-weight:700;color:#0f172a;margin:1rem 0 .75rem;display:flex;align-items:center;gap:.55rem; }
        .form-section-title i { width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:#eef2ff;color:#4f46e5; }
        .form-row-2 { display:grid;grid-template-columns:1fr 1fr;gap:1rem; }
        .form-row-3 { display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem; }
        .form-group  { display:flex;flex-direction:column;gap:.35rem;margin-bottom:.55rem; }
        .form-label  { font-weight:600;font-size:.84rem;color:#334155; }
        .form-control { border-radius:10px; border-color:#dbe3f0; }
        .form-control:focus { border-color:#6366f1; box-shadow:0 0 0 3px rgba(99,102,241,.15); }
        .form-actions { display:flex;gap:1rem;margin-top:1.5rem;padding-top:1.1rem;border-top:1px dashed #d8e0ee; }
        .status-panel { background:linear-gradient(145deg,#f8fafc,#eff6ff);border:1px solid #dbe6ff;border-radius:12px;padding:1rem 1.25rem;margin-bottom:1.5rem; }
        .status-panel h6 { margin:0 0 .75rem;font-weight:600; }
        .status-actions { display:flex;gap:.75rem;flex-wrap:wrap; }
        .meta-hint { font-size:.75rem;color:#64748b;min-height:1rem; }
        .section-divider { margin:1rem 0; border-color:#e7edf7; }
        @@media(max-width:600px){ .form-row-2,.form-row-3{grid-template-columns:1fr;} }
    </style>
}

<div class="page-header">
    <div>
        <div class="page-title">Chỉnh sửa lớp học</div>
        <div class="page-sub"><a asp-action="Index">Lớp học</a> / Chỉnh sửa</div>
    </div>
</div>

<!-- PANEL TRẠNG THÁI -->
<div class="status-panel">
    <h6>Trạng thái hiện tại:
        <span class="badge @Model.TrangThaiBadgeClass">@Model.TrangThaiText</span>
    </h6>
    @if (buocHopLe.Any())
    {
        <div class="status-actions">
            <span style="font-size:.875rem;color:#6b7280;align-self:center;">Chuyển sang:</span>
            @foreach (var step in buocHopLe)
            {
                <form method="post" asp-action="changestatus"
                      onsubmit="return confirm('Xác nhận chuyển sang «@step.Item2»?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.LopHocId" />
                    <input type="hidden" name="trangThaiMoi" value="@step.Item1" />
                    <input type="hidden" name="returnUrl" value="/Admin/Classes/Edit/@Model.LopHocId" />
                    <button type="submit" class="btn @step.Item3 btn-sm">@step.Item2</button>
                </form>
            }
        </div>
    }
    else
    {
        <p class="text-muted mb-0" style="font-size:.875rem;">Không thể chuyển trạng thái từ trạng thái này.</p>
    }
</div>

<div class="card class-edit-card">
    <div class="card-body">
        <form method="post" asp-action="Edit" id="editForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LopHocId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <h5 class="form-section-title"><i class="bi bi-info-circle"></i> Thông tin cơ bản</h5>
            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Tên lớp học <span class="text-danger">*</span></label>
                    <input asp-for="TenLopHoc" class="form-control" />
                    <span asp-validation-for="TenLopHoc" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Mã lớp</label>
                    <input asp-for="MaLopHoc" class="form-control" readonly />
                    <small class="text-muted">Mã lớp được tạo tự động và không cho chỉnh sửa.</small>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Khóa học</label>
                    <select asp-for="KhoaHocId" id="khoaHocSelect" class="form-control">
                        <option value="">-- Chọn khóa học --</option>
                        @foreach (var kh in (List<TrungTamNgoaiNgu.Models.KhoaHoc>)ViewBag.KhoaHocs)
                        {
                            if (Model.KhoaHocId == kh.KhoaHocId)
                            { <option value="@kh.KhoaHocId" selected>@kh.TenKhoaHoc</option> }
                            else
                            { <option value="@kh.KhoaHocId">@kh.TenKhoaHoc</option> }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Gói học phí</label>
                    <select asp-for="HocPhiId" class="form-control">
                        <option value="">-- Chọn gói học phí --</option>
                        @foreach (var hp in (List<TrungTamNgoaiNgu.Models.HocPhi>)ViewBag.HocPhis)
                        {
                            if (Model.HocPhiId == hp.HocPhiId)
                            { <option value="@hp.HocPhiId" selected>@hp.SoBuoi buổi · @hp.DonGia?.ToString("N0")đ/buổi</option> }
                            else
                            { <option value="@hp.HocPhiId">@hp.SoBuoi buổi · @hp.DonGia?.ToString("N0")đ/buổi</option> }
                        }
                    </select>
                </div>
            </div>

            <hr class="section-divider" />

            <h5 class="form-section-title"><i class="bi bi-people"></i> Phân công & Địa điểm</h5>
            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Cơ sở</label>
                    <select asp-for="CoSoId" id="coSoSelect" class="form-control">
                        <option value="">-- Chọn cơ sở --</option>
                        @foreach (var cs in (List<TrungTamNgoaiNgu.Models.CoSoDaoTao>)ViewBag.CoSos)
                        {
                            if (Model.CoSoId == cs.CoSoId)
                            { <option value="@cs.CoSoId" selected>@cs.TenCoSo</option> }
                            else
                            { <option value="@cs.CoSoId">@cs.TenCoSo</option> }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Phòng học</label>
                    <select asp-for="PhongHocId" id="phongHocSelect" class="form-control">
                        <option value="">-- Chọn phòng học --</option>
                        @foreach (var ph in (List<TrungTamNgoaiNgu.Models.PhongHoc>)ViewBag.PhongHocs)
                        {
                            if (Model.PhongHocId == ph.PhongHocId)
                            { <option value="@ph.PhongHocId" data-succhua="@ph.SucChua" selected>@ph.TenPhong (Sức chứa @(ph.SucChua?.ToString() ?? "?"))</option> }
                            else
                            { <option value="@ph.PhongHocId" data-succhua="@ph.SucChua">@ph.TenPhong (Sức chứa @(ph.SucChua?.ToString() ?? "?"))</option> }
                        }
                    </select>
                    <div class="meta-hint" id="phongCapacityInfo"></div>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Giáo viên phụ trách</label>
                    <select asp-for="TaiKhoanId" id="giaoVienSelect" class="form-control">
                        <option value="">-- Chưa phân công --</option>
                        @foreach (var gv in (List<TrungTamNgoaiNgu.Models.TaiKhoan>)ViewBag.GiaoViens)
                        {
                            var ten = gv.HoSo?.HoTen ?? gv.TenTaiKhoan;
                            var coSoId = gv.NhanSu?.CoSoId?.ToString() ?? "";
                            var tenCoSo = gv.NhanSu?.CoSo?.TenCoSo ?? "Chưa gán cơ sở";
                            if (Model.TaiKhoanId == gv.TaiKhoanId)
                            {
                                <option value="@gv.TaiKhoanId"
                                        data-base-label="@ten"
                                        data-coso-id="@coSoId"
                                        data-coso-name="@tenCoSo"
                                        selected>
                                    @ten - @tenCoSo
                                </option>
                            }
                            else
                            {
                                <option value="@gv.TaiKhoanId"
                                        data-base-label="@ten"
                                        data-coso-id="@coSoId"
                                        data-coso-name="@tenCoSo">
                                    @ten - @tenCoSo
                                </option>
                            }
                        }
                    </select>
                    <div class="meta-hint" id="giaoVienScopeInfo"></div>
                </div>
                <div class="form-group">
                    <label class="form-label">Ca học</label>
                    <select asp-for="CaHocId" class="form-control">
                        <option value="">-- Chọn ca học --</option>
                        @foreach (var ca in (List<TrungTamNgoaiNgu.Models.CaHoc>)ViewBag.CaHocs)
                        {
                            if (Model.CaHocId == ca.CaHocId)
                            { <option value="@ca.CaHocId" selected>@ca.TenCa (@ca.GioBatDau - @ca.GioKetThuc)</option> }
                            else
                            { <option value="@ca.CaHocId">@ca.TenCa (@ca.GioBatDau - @ca.GioKetThuc)</option> }
                        }
                    </select>
                </div>
            </div>

            <hr class="section-divider" />

            <h5 class="form-section-title"><i class="bi bi-calendar3"></i> Lịch học & Thời gian</h5>
            <div class="form-group">
                <label class="form-label">Ngày học trong tuần</label>
                <div style="display:flex;gap:1rem;flex-wrap:wrap;">
                    @foreach (var item in new[] { ("2","T2"), ("3","T3"), ("4","T4"), ("5","T5"), ("6","T6"), ("7","T7"), ("CN","CN") })
                    {
                        <label style="display:flex;align-items:center;gap:.4rem;cursor:pointer;">
                            <input type="checkbox" class="lich-hoc-check" value="@item.Item1"
                                   @(lichHocHienTai.Contains(item.Item1) ? "checked" : "") />
                            <span>@item.Item2</span>
                        </label>
                    }
                </div>
                <input asp-for="LichHoc" id="lichHocInput" type="hidden" />
            </div>

            <div class="form-row-3">
                <div class="form-group">
                    <label class="form-label">Ngày bắt đầu</label>
                    <input asp-for="NgayBatDau" type="date" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Ngày kết thúc</label>
                    <input asp-for="NgayKetThuc" type="date" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Số buổi dự kiến</label>
                    <input asp-for="SoBuoiDuKien" type="number" class="form-control" min="1" />
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Sĩ số tối đa</label>
                    <input asp-for="SoHocVienToiDa" id="soHocInput" type="number" class="form-control" min="1" />
                    <div class="meta-hint" id="siSoRuleInfo">Sĩ số phải nhỏ hơn sức chứa phòng học.</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Đơn giá dạy / buổi (đ)</label>
                    <input asp-for="DonGiaDay" type="number" class="form-control" min="0" />
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline">Hủy</a>
                <a asp-action="Detail" asp-route-id="@Model.LopHocId" class="btn btn-outline">
                    <i class="bi bi-eye"></i> Xem chi tiết
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy2"></i> Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const editForm = document.getElementById('editForm');
        const checks = document.querySelectorAll('.lich-hoc-check');
        const lichHocInput = document.getElementById('lichHocInput');
        const coSoSelect = document.getElementById('coSoSelect');
        const phongHocSelect = document.getElementById('phongHocSelect');
        const phongCapacityInfo = document.getElementById('phongCapacityInfo');
        const soHocInput = document.getElementById('soHocInput');
        const giaoVienSelect = document.getElementById('giaoVienSelect');
        const giaoVienScopeInfo = document.getElementById('giaoVienScopeInfo');

        function updateLichHoc() {
            lichHocInput.value = [...checks].filter(c => c.checked).map(c => c.value).join(',');
        }

        function updatePhongCapacityInfo() {
            const selected = phongHocSelect.selectedOptions[0];
            const sucChua = Number(selected?.dataset?.succhua || 0);
            if (!sucChua) {
                phongCapacityInfo.textContent = '';
                soHocInput.removeAttribute('max');
                return;
            }

            phongCapacityInfo.textContent = `Phòng tối đa ${sucChua} học viên. Sĩ số lớp phải nhỏ hơn ${sucChua}.`;
            if (sucChua > 1) soHocInput.max = String(sucChua - 1);
        }

        function refreshGiaoVienLabels() {
            const coSoDangChon = coSoSelect.value;
            [...giaoVienSelect.options].forEach(opt => {
                if (!opt.value) return;
                const baseLabel = opt.dataset.baseLabel || opt.text;
                const coSoId = opt.dataset.cosoId || '';
                const coSoName = opt.dataset.cosoName || 'Chưa gán cơ sở';
                const scope = !coSoDangChon || !coSoId
                    ? 'Chưa xác định'
                    : (coSoId === coSoDangChon ? 'Cùng cơ sở' : 'Khác cơ sở');
                opt.text = `${baseLabel} - ${coSoName} (${scope})`;
            });

            const selected = giaoVienSelect.selectedOptions[0];
            if (!selected || !selected.value) {
                giaoVienScopeInfo.textContent = '';
                return;
            }

            const coSoId = selected.dataset.cosoId || '';
            const coSoName = selected.dataset.cosoName || 'Chưa gán cơ sở';
            if (!coSoSelect.value || !coSoId) {
                giaoVienScopeInfo.textContent = `Giáo viên thuộc: ${coSoName}.`;
                return;
            }

            giaoVienScopeInfo.textContent = coSoId === coSoSelect.value
                ? `Giáo viên cùng cơ sở: ${coSoName}.`
                : `Giáo viên khác cơ sở: ${coSoName} (vẫn được phân công).`;
        }

        checks.forEach(c => c.addEventListener('change', updateLichHoc));
        updateLichHoc();

        if (coSoSelect) {
            coSoSelect.addEventListener('change', async () => {
                const res = await fetch(`/Admin/Classes/PhongHocByCoso?coSoId=${coSoSelect.value}`);
                const data = await res.json();
                phongHocSelect.innerHTML = '<option value="">-- Chọn phòng học --</option>';
                data.forEach(p => {
                    const sucChuaText = p.sucChua ? ` (Sức chứa ${p.sucChua})` : '';
                    phongHocSelect.innerHTML += `<option value="${p.id}" data-succhua="${p.sucChua ?? ''}">${p.name}${sucChuaText}</option>`;
                });
                refreshGiaoVienLabels();
                updatePhongCapacityInfo();
            });
        }

        phongHocSelect.addEventListener('change', updatePhongCapacityInfo);
        giaoVienSelect.addEventListener('change', refreshGiaoVienLabels);
        updatePhongCapacityInfo();
        refreshGiaoVienLabels();

        editForm.addEventListener('submit', (event) => {
            const selectedPhong = phongHocSelect.selectedOptions[0];
            const sucChua = Number(selectedPhong?.dataset?.succhua || 0);
            const siSo = Number(soHocInput.value || 0);
            if (sucChua > 0 && siSo > 0 && siSo >= sucChua) {
                event.preventDefault();
                phongCapacityInfo.textContent = `Sĩ số ${siSo} không hợp lệ. Phải nhỏ hơn sức chứa ${sucChua}.`;
                soHocInput.focus();
            }
        });
    </script>
}
