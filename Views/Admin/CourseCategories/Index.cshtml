@model TrungTamNgoaiNgu.Models.CourseCategoryIndexViewModel
@{
    ViewData["Title"] = "Danh mục khóa học";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int pg = ViewBag.Page ?? 1;
    int pgSize = ViewBag.PageSize ?? 10;
    int total = ViewBag.Total ?? Model.Items.Count;
    int totalPages = (int)Math.Ceiling(total / (double)pgSize);
    string tuKhoa = ViewBag.TuKhoa ?? "";
    string trangThaiQ = ViewBag.TrangThai?.ToString() ?? "";
    var stats = Model.ThongKe ?? new TrungTamNgoaiNgu.Services.Interfaces.DanhMucKhoaHocQuanLyThongKe();
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-courses.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <div class="page-title">Quản lý danh mục khóa học</div>
        <div class="page-sub">Tổng: <strong>@total</strong> danh mục trong cây phân loại</div>
    </div>
    <div class="kh-header-actions">
        <a asp-action="Trash" class="btn btn-outline">
            <i class="bi bi-trash3"></i> Thùng rác
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm danh mục
        </a>
    </div>
</div>

<div class="kh-mini-stats">
    <div class="kh-mini-card all">
        <div class="kh-mini-label">Tổng danh mục</div>
        <div class="kh-mini-value">@stats.TongDanhMuc</div>
    </div>
    <div class="kh-mini-card open">
        <div class="kh-mini-label">Danh mục gốc</div>
        <div class="kh-mini-value">@stats.DanhMucGoc</div>
    </div>
    <div class="kh-mini-card soon">
        <div class="kh-mini-label">Danh mục con</div>
        <div class="kh-mini-value">@stats.DanhMucCon</div>
    </div>
    <div class="kh-mini-card open">
        <div class="kh-mini-label">Đang hoạt động</div>
        <div class="kh-mini-value">@stats.DangHoatDong</div>
    </div>
    <div class="kh-mini-card closed">
        <div class="kh-mini-label">Tạm ngưng</div>
        <div class="kh-mini-value">@stats.TamNgung</div>
    </div>
</div>

<div class="card kh-filter-card">
    <div class="card-body kh-filter-body">
        <form method="get" class="kh-filter-form">
            <div class="search-wrap kh-search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" name="tuKhoa" value="@tuKhoa" class="form-control"
                       placeholder="Tìm theo tên, mã hoặc slug..." />
            </div>

            <select name="trangThai" class="form-control kh-select-trangthai">
                <option value="">Tất cả trạng thái</option>
                @if (trangThaiQ == "1") { <option value="1" selected>Đang hoạt động</option> }
                else { <option value="1">Đang hoạt động</option> }
                @if (trangThaiQ == "0") { <option value="0" selected>Tạm ngưng</option> }
                else { <option value="0">Tạm ngưng</option> }
            </select>

            <select name="pageSize" class="form-control kh-select-pagesize">
                @if (pgSize == 10) { <option value="10" selected>10 dòng/trang</option> }
                else { <option value="10">10 dòng/trang</option> }
                @if (pgSize == 20) { <option value="20" selected>20 dòng/trang</option> }
                else { <option value="20">20 dòng/trang</option> }
                @if (pgSize == 50) { <option value="50" selected>50 dòng/trang</option> }
                else { <option value="50">50 dòng/trang</option> }
            </select>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-funnel-fill"></i> Lọc
            </button>
            @if (!string.IsNullOrEmpty(tuKhoa) || !string.IsNullOrEmpty(trangThaiQ))
            {
                <a asp-action="Index" class="btn btn-outline">
                    <i class="bi bi-x-circle"></i> Xóa lọc
                </a>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="table-wrap">
        @if (!Model.Items.Any())
        {
            <div class="empty-state">
                <i class="bi bi-diagram-3"></i>
                <p>Không tìm thấy danh mục phù hợp.</p>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Danh mục</th>
                        <th>Cấu trúc</th>
                        <th>Slug</th>
                        <th>Sắp xếp</th>
                        <th>Vận hành</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        var dm = item.DanhMuc;
                        <tr>
                            <td class="kh-col-index">@((pg - 1) * pgSize + i + 1)</td>
                            <td>
                                <div class="dm-name-stack">
                                    <div class="dm-tree-line" style="--level:@item.CapDo">
                                        @if (!string.IsNullOrWhiteSpace(dm.MaDanhMuc))
                                        {
                                            <span class="dm-code">@dm.MaDanhMuc</span>
                                        }
                                        <span class="dm-name">@dm.TenDanhMuc</span>
                                    </div>
                                    <div class="kh-slug">@(!string.IsNullOrWhiteSpace(dm.MoTa) ? dm.MoTa : "Chưa có mô tả ngắn")</div>
                                </div>
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(item.DuongDanCha))
                                {
                                    <span class="badge badge-gray">Danh mục gốc</span>
                                }
                                else
                                {
                                    <div class="dm-parent-path">@item.DuongDanCha</div>
                                }
                            </td>
                            <td>
                                <code class="dm-slug">@dm.Slug</code>
                            </td>
                            <td>
                                <div class="dm-order">#@dm.SortOrder</div>
                                <div class="kh-muted">@(item.CapDo == 0 ? "Cấp gốc" : $"Cấp {item.CapDo + 1}")</div>
                            </td>
                            <td>
                                <div class="dm-usage-stack">
                                    <span class="badge badge-gray">@item.SoDanhMucCon danh mục con</span>
                                    <span class="badge badge-indigo">@item.SoKhoaHocTong khóa học</span>
                                    <span class="badge badge-success">@item.SoKhoaHocDangHoatDong đang hoạt động</span>
                                </div>
                            </td>
                            <td>
                                @if (dm.TrangThai == 1)
                                {
                                    <span class="badge badge-success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Tạm ngưng</span>
                                }
                            </td>
                            <td class="kh-created">@dm.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="kh-actions">
                                    <a asp-action="Edit" asp-route-id="@dm.DanhMucId"
                                       class="btn btn-outline btn-sm" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" asp-action="softdelete" asp-route-id="@dm.DanhMucId"
                                          onsubmit="return confirm('Chuyển &laquo;@dm.TenDanhMuc&raquo; vào thùng rác?')"
                                          class="kh-inline-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" title="Xóa mềm">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (totalPages > 1)
            {
                <div class="kh-pagination-wrap">
                    <div class="kh-pagination-info">
                        Trang <strong>@pg</strong> / @totalPages &nbsp;·&nbsp; @total mục
                    </div>
                    <div class="kh-pagination-actions">
                        @if (pg > 1)
                        {
                            <a href="?page=@(pg - 1)&tuKhoa=@tuKhoa&trangThai=@trangThaiQ&pageSize=@pgSize"
                               class="btn btn-outline btn-sm"><i class="bi bi-chevron-left"></i></a>
                        }
                        @for (int p = Math.Max(1, pg - 2); p <= Math.Min(totalPages, pg + 2); p++)
                        {
                            if (p == pg)
                            {
                                <a href="?page=@p&tuKhoa=@tuKhoa&trangThai=@trangThaiQ&pageSize=@pgSize"
                                   class="btn btn-sm btn-primary">@p</a>
                            }
                            else
                            {
                                <a href="?page=@p&tuKhoa=@tuKhoa&trangThai=@trangThaiQ&pageSize=@pgSize"
                                   class="btn btn-sm btn-outline">@p</a>
                            }
                        }
                        @if (pg < totalPages)
                        {
                            <a href="?page=@(pg + 1)&tuKhoa=@tuKhoa&trangThai=@trangThaiQ&pageSize=@pgSize"
                               class="btn btn-outline btn-sm"><i class="bi bi-chevron-right"></i></a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
