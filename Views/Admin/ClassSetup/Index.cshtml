@model TrungTamNgoaiNgu.Models.ClassSetupDashboardViewModel
@{
    ViewData["Title"] = "Thiết lập lớp học";
    ViewData["SetupSection"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var stats = Model.ThongKe;
    var suDung = Model.SuDung;
    var caDangDung = suDung.LopTheoCaHoc.Count(x => x.Value > 0);
    var hocPhiDangDung = suDung.LopTheoHocPhi.Count(x => x.Value > 0);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-class-setup.css" asp-append-version="true" />
}

<div class="page-header setup-page-header">
    <div>
        <div class="page-title">Thiết lập dữ liệu nền cho lớp học</div>
        <div class="page-sub">Class setup giờ chỉ giữ các dữ liệu nền trực tiếp phục vụ mở lớp: `ca học` và `gói học phí`.</div>
    </div>
    <div class="setup-header-actions">
        <a asp-controller="Classes" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Quay lại tạo lớp</a>
        <a asp-controller="Classes" asp-action="Index" class="btn btn-outline"><i class="bi bi-list-ul"></i> Danh sách lớp</a>
    </div>
</div>

@await Html.PartialAsync("~/Views/Admin/ClassSetup/_SetupTabs.cshtml")

<div class="setup-stats">
    <div class="setup-stat-card">
        <div class="label">Ca học</div>
        <div class="value">@stats.TongCaHoc</div>
        <div class="meta">Khung giờ để phân công cho lớp.</div>
    </div>
    <div class="setup-stat-card">
        <div class="label">Gói học phí</div>
        <div class="value">@stats.TongHocPhi</div>
        <div class="meta">@stats.KhoaHocChuaCoHocPhi khóa học chưa có gói học phí.</div>
    </div>
</div>

<div class="setup-grid">
    <section class="setup-panel">
        <div class="setup-panel-body">
            <div class="setup-panel-title">
                <div>
                    <h5>Checklist sẵn sàng tạo lớp</h5>
                    <p>Đi đủ 2 bước này thì form tạo lớp sẽ chọn được dữ liệu nền cốt lõi.</p>
                </div>
            </div>
            <div class="setup-kpi-grid">
                <div class="setup-kpi">
                    <div class="value">@stats.TongCaHoc</div>
                    <div class="label">Ca học đã có</div>
                </div>
                <div class="setup-kpi">
                    <div class="value">@stats.TongHocPhi</div>
                    <div class="label">Gói học phí đã có</div>
                </div>
            </div>
        </div>
    </section>

    <section class="setup-panel">
        <div class="setup-panel-body">
            <div class="setup-panel-title">
                <div>
                    <h5>Lối đi nhanh</h5>
                    <p>Hoàn thiện ca học và học phí tại đây; phần cơ sở/phòng học đã chuyển sang module riêng.</p>
                </div>
            </div>
            <div class="setup-header-actions">
                <a asp-action="CaHoc" class="btn btn-outline"><i class="bi bi-clock-history"></i> Quản lý ca học</a>
                <a asp-action="HocPhi" class="btn btn-outline"><i class="bi bi-cash-coin"></i> Quản lý học phí</a>
                <a asp-controller="Campuses" asp-action="Index" class="btn btn-outline"><i class="bi bi-buildings"></i> Module cơ sở đào tạo</a>
            </div>
            <div class="setup-inline-note" style="margin-top:.9rem;">
                <i class="bi bi-info-circle"></i>
                <div>Form lớp chỉ dùng các bản ghi đang `Hoạt động`. Phần cơ sở và phòng học được quản lý riêng theo từng cơ sở để dễ vận hành hơn.</div>
            </div>
        </div>
    </section>

    <section class="setup-panel">
        <div class="setup-panel-body">
            <div class="setup-panel-title">
                <div>
                    <h5>Mức độ sử dụng hiện tại</h5>
                    <p>Nhìn nhanh dữ liệu nền nào đang gắn với lớp thật để tránh chỉnh sửa quá tay.</p>
                </div>
            </div>
            <div class="setup-kpi-grid">
                <div class="setup-kpi">
                    <div class="value">@caDangDung</div>
                    <div class="label">Ca học đang có lớp</div>
                </div>
                <div class="setup-kpi">
                    <div class="value">@hocPhiDangDung</div>
                    <div class="label">Gói học phí đang áp dụng</div>
                </div>
            </div>
        </div>
    </section>
</div>
