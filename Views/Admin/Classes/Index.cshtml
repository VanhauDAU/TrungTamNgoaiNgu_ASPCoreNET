@model List<TrungTamNgoaiNgu.Models.LopHoc>
@using TrungTamNgoaiNgu.Enums
@{
    ViewData["Title"] = "Lớp học";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int pg         = ViewBag.Page ?? 1;
    int pgSize     = ViewBag.PageSize ?? 10;
    int total      = ViewBag.Total ?? Model.Count;
    int totalPages = (int)Math.Ceiling(total / (double)pgSize);
    string tuKhoa    = ViewBag.TuKhoa    ?? "";
    string khoaHocQ  = ViewBag.KhoaHocId?.ToString() ?? "";
    string coSoQ     = ViewBag.CoSoId?.ToString()    ?? "";
    string trangThaiQ = ViewBag.TrangThai?.ToString() ?? "";
    var stats = ViewBag.Stats as TrungTamNgoaiNgu.Services.Interfaces.LopHocQuanLyThongKe
             ?? new TrungTamNgoaiNgu.Services.Interfaces.LopHocQuanLyThongKe();

    var trangThaiOptions = new (int Val, string Label)[]
    {
        (0, "🕐 Sắp mở"),
        (1, "📋 Đang tuyển sinh"),
        (2, "✅ Chốt danh sách"),
        (3, "❌ Đã hủy"),
        (4, "🎓 Đang học"),
        (5, "🏁 Đã kết thúc"),
    };
}

@section Styles {
    <style>
        .lh-mini-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:1rem; margin-bottom:1.4rem; }
        .lh-mini-card  { position:relative; overflow:hidden; background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:1rem 1.1rem;text-align:left;box-shadow:0 10px 30px rgba(15,23,42,.06); transition:transform .2s ease, box-shadow .2s ease; }
        .lh-mini-card:hover { transform:translateY(-2px); box-shadow:0 14px 35px rgba(15,23,42,.11); }
        .lh-mini-card::after { content:''; position:absolute; inset:auto 0 0 0; height:3px; opacity:.95; }
        .lh-mini-card.all::after { background:#6366f1; }
        .lh-mini-card.open::after { background:#10b981; }
        .lh-mini-card.active::after { background:#3b82f6; }
        .lh-mini-card.done::after { background:#8b5cf6; }
        .lh-mini-card.cancel::after { background:#ef4444; }
        .lh-mini-label { font-size:.75rem;color:#64748b;margin-bottom:.3rem;text-transform:uppercase;letter-spacing:.05em; }
        .lh-mini-value { font-size:1.6rem;font-weight:800;color:#0f172a;line-height:1.1; }
        .lh-actions { display:flex;gap:.4rem;align-items:center; }
        .lh-inline-form { margin:0; }
        .lh-table tr td { vertical-align:middle; }
        .lh-table td .kh-name { font-weight:600; color:#0f172a; }
        .lh-table td .kh-slug { font-size:.78rem; color:#64748b; }
        .lh-meta { display:flex; align-items:center; gap:.35rem; color:#64748b; font-size:.8rem; }
        .lh-meta i { color:#94a3b8; }
        .lh-table tbody tr { border-bottom:1px solid #edf2f7; }
        .lh-table tbody tr:hover { background:#f8fbff; }
        .lh-name-stack { display:flex; flex-direction:column; gap:.35rem; min-width:220px; }
        .lh-code-row { display:flex; flex-wrap:wrap; gap:.45rem; align-items:center; }
        .lh-code-pill { display:inline-flex; align-items:center; gap:.35rem; padding:.25rem .55rem; border-radius:999px; background:#eef2ff; color:#4338ca; font-size:.76rem; font-weight:700; }
        .lh-chip { display:inline-flex; align-items:center; gap:.3rem; padding:.24rem .5rem; border-radius:999px; background:#f8fafc; border:1px solid #e2e8f0; color:#475569; font-size:.75rem; }
        .lh-course-stack, .lh-schedule-stack, .lh-campus-stack { display:flex; flex-direction:column; gap:.35rem; }
        .lh-progress { height:8px; border-radius:999px; background:#e2e8f0; overflow:hidden; margin-top:.45rem; }
        .lh-progress > span { display:block; height:100%; border-radius:999px; background:linear-gradient(90deg,#10b981,#3b82f6); }
        .lh-occupancy { min-width:150px; }
        .lh-occupancy strong { color:#0f172a; font-size:.95rem; }
        .lh-inline-note { font-size:.76rem; color:#64748b; }
        .lh-time-badge { display:inline-flex; align-items:center; gap:.35rem; padding:.25rem .55rem; border-radius:999px; background:#eff6ff; color:#1d4ed8; font-size:.75rem; font-weight:700; }
        .lh-empty-soft { color:#94a3b8; font-size:.82rem; }
        .lh-filter-card { margin-bottom:1.2rem; border:1px solid #dbe5f4; border-radius:18px; box-shadow:0 14px 36px rgba(15,23,42,.06); overflow:hidden; }
        .lh-filter-body { padding:1rem 1.1rem 1.1rem; background:linear-gradient(180deg,#ffffff 0%,#f8fbff 100%); }
        .lh-filter-top { display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; margin-bottom:.9rem; flex-wrap:wrap; }
        .lh-filter-title { font-size:1rem; font-weight:800; color:#0f172a; margin:0 0 .15rem; }
        .lh-filter-sub { font-size:.82rem; color:#64748b; margin:0; }
        .lh-filter-badge { display:inline-flex; align-items:center; gap:.4rem; padding:.42rem .7rem; border-radius:999px; background:#eef4ff; color:#3157c7; font-size:.78rem; font-weight:700; }
        .lh-filter-form { display:grid; grid-template-columns:minmax(240px,1.4fr) repeat(4,minmax(150px,1fr)) auto auto; gap:.75rem; align-items:end; }
        .lh-filter-field { display:flex; flex-direction:column; gap:.35rem; }
        .lh-filter-field label { font-size:.78rem; font-weight:700; color:#475569; }
        .lh-filter-field .form-control { height:46px; border-radius:12px; border-color:#dbe3f0; background:#fff; }
        .lh-filter-search { position:relative; }
        .lh-filter-search i { position:absolute; left:.9rem; top:50%; transform:translateY(-50%); color:#94a3b8; }
        .lh-filter-search input { padding-left:2.45rem; }
        .lh-filter-actions { display:flex; gap:.55rem; align-items:end; }
        .lh-filter-actions .btn { height:46px; border-radius:12px; padding-inline:1rem; }
        @@media(max-width:1250px){ .lh-filter-form{grid-template-columns:repeat(3,minmax(0,1fr));} .lh-filter-actions{grid-column:1 / -1;} }
        @@media(max-width:820px){ .lh-filter-form{grid-template-columns:1fr 1fr;} }
        @@media(max-width:560px){ .lh-filter-form{grid-template-columns:1fr;} .lh-filter-actions{flex-direction:column;} .lh-filter-actions .btn{width:100%; justify-content:center;} }
    </style>
}

<div class="page-header">
    <div>
        <div class="page-title">Quản lý lớp học</div>
        <div class="page-sub">Tổng: <strong>@total</strong> lớp học</div>
    </div>
    <div class="kh-header-actions">
        <a asp-action="Trash" class="btn btn-outline">
            <i class="bi bi-trash3"></i> Thùng rác
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm lớp học
        </a>
    </div>
</div>

@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> @TempData["ThanhCong"]</div>
}
@if (TempData["LoiXay"] != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["LoiXay"]</div>
}

<!-- STATS CARDS -->
<div class="lh-mini-stats">
    <div class="lh-mini-card all">
        <div class="lh-mini-label">Tổng lớp học</div>
        <div class="lh-mini-value">@stats.TongLopHoc</div>
    </div>
    <div class="lh-mini-card open">
        <div class="lh-mini-label">Đang tuyển sinh</div>
        <div class="lh-mini-value">@stats.DangTuyenSinh</div>
    </div>
    <div class="lh-mini-card active">
        <div class="lh-mini-label">Đang học</div>
        <div class="lh-mini-value">@stats.DangHoc</div>
    </div>
    <div class="lh-mini-card done">
        <div class="lh-mini-label">Đã kết thúc</div>
        <div class="lh-mini-value">@stats.DaKetThuc</div>
    </div>
    <div class="lh-mini-card cancel">
        <div class="lh-mini-label">Đã hủy</div>
        <div class="lh-mini-value">@stats.DaHuy</div>
    </div>
</div>

<!-- BỘ LỌC -->
<div class="card lh-filter-card">
    <div class="card-body lh-filter-body">
        <div class="lh-filter-top">
            <div>
                <div class="lh-filter-title">Bộ lọc lớp học</div>
                <p class="lh-filter-sub">Tìm nhanh theo tên lớp, khóa học, cơ sở hoặc trạng thái vận hành.</p>
            </div>
            <span class="lh-filter-badge"><i class="bi bi-funnel"></i> @total lớp phù hợp</span>
        </div>
        <form method="get" class="lh-filter-form">
            <div class="lh-filter-field">
                <label for="tuKhoaInput">Từ khóa</label>
                <div class="lh-filter-search">
                    <i class="bi bi-search"></i>
                    <input id="tuKhoaInput" type="text" name="tuKhoa" value="@tuKhoa" class="form-control"
                           placeholder="Tìm tên / mã lớp học..." />
                </div>
            </div>

            <div class="lh-filter-field">
                <label for="khoaHocFilter">Khóa học</label>
                <select id="khoaHocFilter" name="khoaHocId" class="form-control">
                    <option value="">Tất cả khóa học</option>
                    @foreach (var kh in (List<TrungTamNgoaiNgu.Models.KhoaHoc>)ViewBag.KhoaHocs)
                    {
                        if (khoaHocQ == kh.KhoaHocId.ToString())
                        { <option value="@kh.KhoaHocId" selected>@kh.TenKhoaHoc</option> }
                        else
                        { <option value="@kh.KhoaHocId">@kh.TenKhoaHoc</option> }
                    }
                </select>
            </div>

            <div class="lh-filter-field">
                <label for="coSoFilter">Cơ sở</label>
                <select id="coSoFilter" name="coSoId" class="form-control">
                    <option value="">Tất cả cơ sở</option>
                    @foreach (var cs in (List<TrungTamNgoaiNgu.Models.CoSoDaoTao>)ViewBag.CoSos)
                    {
                        if (coSoQ == cs.CoSoId.ToString())
                        { <option value="@cs.CoSoId" selected>@cs.TenCoSo</option> }
                        else
                        { <option value="@cs.CoSoId">@cs.TenCoSo</option> }
                    }
                </select>
            </div>

            <div class="lh-filter-field">
                <label for="trangThaiFilter">Trạng thái</label>
                <select id="trangThaiFilter" name="trangThai" class="form-control">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var opt in trangThaiOptions)
                    {
                        if (trangThaiQ == opt.Val.ToString())
                        { <option value="@opt.Val" selected>@opt.Label</option> }
                        else
                        { <option value="@opt.Val">@opt.Label</option> }
                    }
                </select>
            </div>

            <div class="lh-filter-field">
                <label for="pageSizeFilter">Hiển thị</label>
                <select id="pageSizeFilter" name="pageSize" class="form-control">
                    @foreach (var s in new[] { 10, 20, 50 })
                    {
                        if (pgSize == s)
                        { <option value="@s" selected>@s dòng/trang</option> }
                        else
                        { <option value="@s">@s dòng/trang</option> }
                    }
                </select>
            </div>

            <div class="lh-filter-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel-fill"></i> Lọc</button>
                @if (!string.IsNullOrEmpty(tuKhoa) || !string.IsNullOrEmpty(khoaHocQ) || !string.IsNullOrEmpty(coSoQ) || !string.IsNullOrEmpty(trangThaiQ))
                {
                    <a asp-action="Index" class="btn btn-outline"><i class="bi bi-x-circle"></i> Xóa lọc</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- BẢNG -->
<div class="card">
    <div class="table-wrap">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-people"></i>
                <p>Không tìm thấy lớp học nào</p>
            </div>
        }
        else
        {
            <table class="lh-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Lớp học</th>
                        <th>Khóa học</th>
                        <th>Cơ sở vận hành</th>
                        <th>Sĩ số</th>
                        <th>Lịch học</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var lop = Model[i];
                        var soDangKy = lop.DangKys?.Count ?? 0;
                        var soToiDa = lop.SoHocVienToiDa ?? 0;
                        var tiLeLapDay = soToiDa > 0
                            ? Math.Min(100, (int)Math.Round((double)soDangKy * 100 / soToiDa))
                            : 0;
                        <tr>
                            <td class="kh-col-index">@((pg - 1) * pgSize + i + 1)</td>
                            <td>
                                <div class="lh-name-stack">
                                    <div class="kh-name">@lop.TenLopHoc</div>
                                    <div class="lh-code-row">
                                        @if (!string.IsNullOrEmpty(lop.MaLopHoc))
                                        {
                                            <span class="lh-code-pill"><i class="bi bi-hash"></i> @lop.MaLopHoc</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(lop.LichHoc))
                                        {
                                            <span class="lh-chip"><i class="bi bi-calendar-week"></i> @lop.LichHoc</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="lh-course-stack">
                                    @if (lop.KhoaHoc != null)
                                    {
                                        <span class="badge badge-indigo">@lop.KhoaHoc.TenKhoaHoc</span>
                                        <div class="lh-inline-note">
                                            @(!string.IsNullOrWhiteSpace(lop.KhoaHoc.MaKhoaHoc) ? lop.KhoaHoc.MaKhoaHoc : "Chưa có mã khóa học")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="lh-empty-soft">Chưa gắn khóa học</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="lh-campus-stack">
                                    <div>@(lop.CoSo?.TenCoSo ?? "Chưa chọn cơ sở")</div>
                                    <div class="lh-meta"><i class="bi bi-door-open"></i> @(lop.PhongHoc?.TenPhong ?? "Chưa gán phòng")</div>
                                    <div class="lh-meta"><i class="bi bi-clock"></i> @(lop.CaHoc?.TenCa ?? "Chưa chọn ca")</div>
                                </div>
                            </td>
                            <td>
                                <div class="lh-occupancy">
                                    <strong>@soDangKy / @(soToiDa > 0 ? soToiDa : 0)</strong>
                                    <div class="lh-inline-note">Mức lấp đầy: @tiLeLapDay%</div>
                                    <div class="lh-progress"><span style="width:@tiLeLapDay%"></span></div>
                                </div>
                            </td>
                            <td>
                                <div class="lh-schedule-stack">
                                    @if (lop.NgayBatDau.HasValue)
                                    {
                                        <span class="lh-time-badge"><i class="bi bi-play-circle"></i> @lop.NgayBatDau.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="lh-empty-soft">Chưa có ngày bắt đầu</span>
                                    }
                                    @if (lop.NgayKetThuc.HasValue)
                                    {
                                        <div class="lh-inline-note">Kết thúc: @lop.NgayKetThuc.Value.ToString("dd/MM/yyyy")</div>
                                    }
                                    @if (lop.SoBuoiDuKien.HasValue)
                                    {
                                        <div class="lh-inline-note">@lop.SoBuoiDuKien buổi dự kiến</div>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="badge @lop.TrangThaiBadgeClass">@lop.TrangThaiText</span>
                            </td>
                            <td>
                                <div class="lh-actions">
                                    <a asp-action="Detail" asp-route-id="@lop.LopHocId"
                                       class="btn btn-outline btn-sm" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@lop.LopHocId"
                                       class="btn btn-outline btn-sm" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" asp-action="softdelete" asp-route-id="@lop.LopHocId"
                                          onsubmit="return confirm('Chuyển «@lop.TenLopHoc» vào thùng rác?')"
                                          class="lh-inline-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" title="Xóa mềm">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (totalPages > 1)
            {
                <div class="kh-pagination-wrap">
                    <div class="kh-pagination-info">
                        Trang <strong>@pg</strong> / @totalPages &nbsp;·&nbsp; @total mục
                    </div>
                    <div class="kh-pagination-actions">
                        @if (pg > 1)
                        {
                            <a href="?page=@(pg-1)&tuKhoa=@tuKhoa&khoaHocId=@khoaHocQ&coSoId=@coSoQ&trangThai=@trangThaiQ&pageSize=@pgSize"
                               class="btn btn-outline btn-sm"><i class="bi bi-chevron-left"></i></a>
                        }
                        @for (int p = Math.Max(1, pg - 2); p <= Math.Min(totalPages, pg + 2); p++)
                        {
                            <a href="?page=@p&tuKhoa=@tuKhoa&khoaHocId=@khoaHocQ&coSoId=@coSoQ&trangThai=@trangThaiQ&pageSize=@pgSize"
                               class="btn btn-sm @(p == pg ? "btn-primary" : "btn-outline")">@p</a>
                        }
                        @if (pg < totalPages)
                        {
                            <a href="?page=@(pg+1)&tuKhoa=@tuKhoa&khoaHocId=@khoaHocQ&coSoId=@coSoQ&trangThai=@trangThaiQ&pageSize=@pgSize"
                               class="btn btn-outline btn-sm"><i class="bi bi-chevron-right"></i></a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
