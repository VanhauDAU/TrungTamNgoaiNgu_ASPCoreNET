@model TrungTamNgoaiNgu.Models.PhongHocManagementViewModel
@{
    ViewData["Title"] = "Phòng học";
    ViewData["SetupSection"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-class-setup.css" asp-append-version="true" />
}

<div class="page-header setup-page-header">
    <div>
        <div class="page-title">Phòng học đã chuyển vào chi tiết cơ sở</div>
        <div class="page-sub">Phòng học bây giờ được quản lý trực tiếp trong từng cơ sở để bạn theo dõi ngữ cảnh vận hành, nhân sự và lớp học ngay trên một trang detail theo tabs.</div>
    </div>
    <div class="setup-header-actions">
        <a asp-controller="Campuses" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-door-open"></i> Đi tới Cơ sở đào tạo
        </a>
        <a asp-action="Index" class="btn btn-outline">
            <i class="bi bi-sliders"></i> Quay lại setup
        </a>
    </div>
</div>

@await Html.PartialAsync("~/Views/Admin/ClassSetup/_SetupTabs.cshtml")

<section class="setup-panel">
    <div class="setup-panel-body">
        <div class="setup-empty">
            <i class="bi bi-arrow-right-circle"></i>
            Chọn một cơ sở trong module `Cơ sở đào tạo` để thêm, sửa và theo dõi phòng học của đúng chi nhánh đó.
        </div>
    </div>
</section>
