@model TrungTamNgoaiNgu.Models.LopHoc
@using TrungTamNgoaiNgu.Enums
@{
    ViewData["Title"] = "Chỉnh sửa lớp học";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var lichHocHienTai = (Model.LichHoc ?? "").Split(',', System.StringSplitOptions.RemoveEmptyEntries);
    var tinhThanhHienTaiId = Model.CoSo?.TinhThanhId;
    var phuongXaHienTai = Model.CoSo?.TenPhuongXa ?? string.Empty;

    var buocHopLe = Model.TrangThai switch
    {
        LopHocTrangThai.SapMo         => new (int val, string label, string cls)[] { (1,"Mở tuyển sinh","btn-success"), (3,"Hủy lớp","btn-danger") },
        LopHocTrangThai.DangTuyenSinh => new (int val, string label, string cls)[] { (2,"Chốt danh sách","btn-primary"), (3,"Hủy lớp","btn-danger") },
        LopHocTrangThai.ChotDanhSach  => new (int val, string label, string cls)[] { (4,"Khai giảng","btn-primary"), (3,"Hủy lớp","btn-danger") },
        LopHocTrangThai.DangHoc       => new (int val, string label, string cls)[] { (5,"Kết thúc lớp","btn-secondary") },
        _                             => Array.Empty<(int,string,string)>()
    };
}

@section Styles {
    <style>
        .class-page-header { margin-bottom:.75rem; }
        .class-page-header .page-title { font-size:1.65rem; letter-spacing:-.02em; }
        .class-workspace { display:grid; grid-template-columns:minmax(0,1fr) 340px; gap:1rem; align-items:start; width:100%; }
        .class-main { min-width:0; }
        .class-side { position:sticky; top:calc(var(--th,64px) + 14px); display:flex; flex-direction:column; gap:.85rem; }
        .class-edit-card { max-width:none; width:100%; border:1px solid #dbe5f4; border-radius:18px; overflow:hidden; box-shadow:0 16px 40px rgba(15,23,42,.08); }
        .class-edit-card .card-body { padding:1.15rem 1.15rem 1rem; background:linear-gradient(180deg,#ffffff 0%,#f8fbff 100%); }
        .class-hero { padding:1rem; border:1px solid #dbe6ff; border-radius:16px; background:linear-gradient(135deg,#e9f2ff 0%,#fbfdff 60%,#eef6ff 100%); box-shadow:0 18px 40px rgba(59,130,246,.12); }
        .class-hero.sticky { position:sticky; top:calc(var(--th,64px) + 14px); }
        .hero-grid { display:grid; grid-template-columns:1fr; gap:.65rem; }
        .hero-item { background:rgba(255,255,255,.82); border:1px solid #dbe5f7; border-radius:12px; padding:.7rem .8rem; min-height:68px; }
        .hero-label { font-size:.7rem; color:#64748b; text-transform:uppercase; letter-spacing:.05em; margin-bottom:.2rem; }
        .hero-value { font-size:.84rem; color:#0f172a; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .hero-actions { display:grid; grid-template-columns:1fr; gap:.55rem; margin-top:.85rem; }
        .lh-panel { border:1px solid #e6edf9; border-radius:14px; padding:1rem 1rem .9rem; background:#fff; box-shadow:0 8px 25px rgba(15,23,42,.05); margin-bottom:.85rem; }
        .panel-sub { margin:-.35rem 0 .85rem 0; color:#64748b; font-size:.8rem; }
        .form-section-title { font-weight:700;color:#0f172a;margin:1rem 0 .75rem;display:flex;align-items:center;gap:.55rem; }
        .form-section-title i { width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:#eef2ff;color:#4f46e5; }
        .form-row-2 { display:grid;grid-template-columns:1fr 1fr;gap:1rem; }
        .form-row-3 { display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem; }
        .form-group  { display:flex;flex-direction:column;gap:.35rem;margin-bottom:.55rem; }
        .form-label  { font-weight:600;font-size:.84rem;color:#334155; }
        .form-control { border-radius:10px; border-color:#dbe3f0; }
        .form-control:focus { border-color:#6366f1; box-shadow:0 0 0 3px rgba(99,102,241,.15); }
        .form-actions { display:flex;gap:.75rem;justify-content:flex-end;flex-wrap:wrap;margin-top:.4rem;padding:.85rem;border:1px solid #dbe6ff;border-radius:14px;background:linear-gradient(180deg,#ffffff,#f8fbff); position:sticky; bottom:.35rem; z-index:6; box-shadow:0 10px 28px rgba(15,23,42,.08); }
        .status-panel { background:linear-gradient(145deg,#f8fafc,#eff6ff);border:1px solid #dbe6ff;border-radius:14px;padding:1rem 1.05rem;margin:0; box-shadow:0 14px 30px rgba(15,23,42,.08); }
        .status-panel h6 { margin:0 0 .75rem;font-weight:600; }
        .status-actions { display:flex;gap:.75rem;flex-wrap:wrap; }
        .meta-hint { font-size:.75rem;color:#64748b;min-height:1rem; }
        .section-divider { margin:1rem 0; border-color:#e7edf7; }
        @@media(max-width:1120px){ .class-workspace{grid-template-columns:1fr;} .class-side{position:static;} .class-hero.sticky{position:static;} .hero-grid{grid-template-columns:repeat(2,minmax(0,1fr));} }
        @@media(max-width:700px){
            .form-row-2,.form-row-3,.hero-grid{grid-template-columns:1fr;}
            .class-edit-card .card-body{padding:1.2rem;}
            .form-actions{position:static;}
        }
    </style>
}

<div class="page-header class-page-header">
    <div>
        <div class="page-title">Chỉnh sửa lớp học</div>
        <div class="page-sub"><a asp-action="Index">Lớp học</a> / Chỉnh sửa / Không gian vận hành lớp</div>
    </div>
    <div class="lh-actions">
        <a asp-controller="ClassSetup" asp-action="Index" class="btn btn-outline"><i class="bi bi-sliders"></i> Thiết lập dữ liệu nền</a>
        <a asp-action="Index" class="btn btn-outline"><i class="bi bi-list-ul"></i> Danh sách lớp</a>
        <a asp-action="Detail" asp-route-id="@Model.LopHocId" class="btn btn-outline"><i class="bi bi-eye"></i> Chi tiết</a>
    </div>
</div>

<div class="class-workspace">
    <div class="class-main">
    <div class="card class-edit-card">
        <div class="card-body">
        <form method="post" asp-action="Edit" id="editForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LopHocId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="lh-panel">
            <h5 class="form-section-title"><i class="bi bi-info-circle"></i> Thông tin cơ bản</h5>
            <p class="panel-sub">Cập nhật tên lớp, khóa học và gói học phí cho lớp hiện tại.</p>
            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Tên lớp học <span class="text-danger">*</span></label>
                    <input asp-for="TenLopHoc" class="form-control" />
                    <span asp-validation-for="TenLopHoc" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Mã lớp</label>
                    <input asp-for="MaLopHoc" class="form-control" readonly />
                    <small class="text-muted">Mã lớp được tạo tự động và không cho chỉnh sửa.</small>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Khóa học</label>
                    <select asp-for="KhoaHocId" id="khoaHocSelect" class="form-control">
                        <option value="">-- Chọn khóa học --</option>
                        @foreach (var kh in (List<TrungTamNgoaiNgu.Models.KhoaHoc>)ViewBag.KhoaHocs)
                        {
                            if (Model.KhoaHocId == kh.KhoaHocId)
                            { <option value="@kh.KhoaHocId" selected>@kh.TenKhoaHoc</option> }
                            else
                            { <option value="@kh.KhoaHocId">@kh.TenKhoaHoc</option> }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Gói học phí</label>
                    <select asp-for="HocPhiId" id="hocPhiSelect" class="form-control">
                        <option value="">-- Chọn gói học phí --</option>
                        @foreach (var hp in (List<TrungTamNgoaiNgu.Models.HocPhi>)ViewBag.HocPhis)
                        {
                            if (Model.HocPhiId == hp.HocPhiId)
                            {
                                <option value="@hp.HocPhiId"
                                        data-so-buoi="@hp.SoBuoi"
                                        data-tong-tien="@hp.TongHocPhi.ToString("N0")"
                                        selected>
                                    @hp.SoBuoi buổi · @hp.DonGia?.ToString("N0")đ/buổi
                                </option>
                            }
                            else
                            {
                                <option value="@hp.HocPhiId"
                                        data-so-buoi="@hp.SoBuoi"
                                        data-tong-tien="@hp.TongHocPhi.ToString("N0")">
                                    @hp.SoBuoi buổi · @hp.DonGia?.ToString("N0")đ/buổi
                                </option>
                            }
                        }
                    </select>
                    <div class="meta-hint" id="hocPhiInfo"></div>
                    <small class="text-muted">Thiếu gói học phí? <a asp-controller="ClassSetup" asp-action="HocPhi">Quản lý ngay</a></small>
                </div>
            </div>
            </div>

            <div class="lh-panel">
            <h5 class="form-section-title"><i class="bi bi-people"></i> Phân công & Địa điểm</h5>
            <p class="panel-sub">Điều chỉnh cơ sở, phòng học, giáo viên và ca học.</p>
            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Tỉnh/Thành phố</label>
                    <select id="tinhThanhSelect" class="form-control">
                        <option value="">-- Chọn tỉnh/thành phố --</option>
                        @foreach (var tt in (List<TrungTamNgoaiNgu.Models.TinhThanh>)ViewBag.TinhThanhs)
                        {
                            if (tinhThanhHienTaiId == tt.TinhThanhId)
                            {
                                <option value="@tt.TinhThanhId" selected>@tt.TenTinhThanh</option>
                            }
                            else
                            {
                                <option value="@tt.TinhThanhId">@tt.TenTinhThanh</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Phường/Xã</label>
                    <select id="phuongXaSelect" class="form-control" data-selected="@phuongXaHienTai">
                        @if (!string.IsNullOrWhiteSpace(phuongXaHienTai))
                        {
                            <option value="@phuongXaHienTai" selected>@phuongXaHienTai</option>
                        }
                        else
                        {
                            <option value="">-- Chọn tỉnh/thành trước --</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Cơ sở</label>
                    <select asp-for="CoSoId" id="coSoSelect" class="form-control">
                        <option value="">-- Chọn cơ sở --</option>
                        @foreach (var cs in (List<TrungTamNgoaiNgu.Models.CoSoDaoTao>)ViewBag.CoSos)
                        {
                            if (Model.CoSoId == cs.CoSoId)
                            { <option value="@cs.CoSoId" data-diachi="@cs.DiaChi" selected>@cs.TenCoSo</option> }
                            else
                            { <option value="@cs.CoSoId" data-diachi="@cs.DiaChi">@cs.TenCoSo</option> }
                        }
                    </select>
                    <div class="meta-hint" id="coSoDiaChi"></div>
                    <small class="text-muted">Thiếu cơ sở? <a asp-controller="ClassSetup" asp-action="CoSo">Thêm cơ sở đào tạo</a></small>
                </div>
                <div class="form-group">
                    <label class="form-label">Phòng học</label>
                    <select asp-for="PhongHocId" id="phongHocSelect" class="form-control">
                        <option value="">-- Chọn phòng học --</option>
                        @foreach (var ph in (List<TrungTamNgoaiNgu.Models.PhongHoc>)ViewBag.PhongHocs)
                        {
                            if (Model.PhongHocId == ph.PhongHocId)
                            { <option value="@ph.PhongHocId" data-succhua="@ph.SucChua" selected>@ph.TenPhong (Sức chứa @(ph.SucChua?.ToString() ?? "?"))</option> }
                            else
                            { <option value="@ph.PhongHocId" data-succhua="@ph.SucChua">@ph.TenPhong (Sức chứa @(ph.SucChua?.ToString() ?? "?"))</option> }
                        }
                    </select>
                    <div class="meta-hint" id="phongCapacityInfo"></div>
                    <small class="text-muted">Thiếu phòng học? <a asp-controller="ClassSetup" asp-action="PhongHoc">Quản lý phòng học</a></small>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Giáo viên phụ trách</label>
                    <select asp-for="TaiKhoanId" id="giaoVienSelect" class="form-control">
                        <option value="">-- Chưa phân công --</option>
                        @foreach (var gv in (List<TrungTamNgoaiNgu.Models.TaiKhoan>)ViewBag.GiaoViens)
                        {
                            var ten = gv.HoSo?.HoTen ?? gv.TenTaiKhoan;
                            var coSoId = gv.NhanSu?.CoSoId?.ToString() ?? "";
                            var tenCoSo = gv.NhanSu?.CoSo?.TenCoSo ?? "Chưa gán cơ sở";
                            if (Model.TaiKhoanId == gv.TaiKhoanId)
                            {
                                <option value="@gv.TaiKhoanId"
                                        data-base-label="@ten"
                                        data-coso-id="@coSoId"
                                        data-coso-name="@tenCoSo"
                                        selected>
                                    @ten - @tenCoSo
                                </option>
                            }
                            else
                            {
                                <option value="@gv.TaiKhoanId"
                                        data-base-label="@ten"
                                        data-coso-id="@coSoId"
                                        data-coso-name="@tenCoSo">
                                    @ten - @tenCoSo
                                </option>
                            }
                        }
                    </select>
                    <div class="meta-hint" id="giaoVienScopeInfo"></div>
                </div>
                <div class="form-group">
                    <label class="form-label">Ca học</label>
                    <select asp-for="CaHocId" class="form-control">
                        <option value="">-- Chọn ca học --</option>
                        @foreach (var ca in (List<TrungTamNgoaiNgu.Models.CaHoc>)ViewBag.CaHocs)
                        {
                            if (Model.CaHocId == ca.CaHocId)
                            { <option value="@ca.CaHocId" selected>@ca.TenCa (@ca.GioBatDau - @ca.GioKetThuc)</option> }
                            else
                            { <option value="@ca.CaHocId">@ca.TenCa (@ca.GioBatDau - @ca.GioKetThuc)</option> }
                        }
                    </select>
                    <small class="text-muted">Thiếu ca học? <a asp-controller="ClassSetup" asp-action="CaHoc">Thiết lập ca học</a></small>
                </div>
            </div>
            </div>

            <div class="lh-panel">
            <h5 class="form-section-title"><i class="bi bi-calendar3"></i> Lịch học & Thời gian</h5>
            <p class="panel-sub">Cập nhật lịch học, số buổi và giới hạn sĩ số theo sức chứa phòng.</p>
            <div class="form-group">
                <label class="form-label">Ngày học trong tuần</label>
                <div style="display:flex;gap:1rem;flex-wrap:wrap;">
                    @foreach (var item in new[] { ("2","T2"), ("3","T3"), ("4","T4"), ("5","T5"), ("6","T6"), ("7","T7"), ("CN","CN") })
                    {
                        <label style="display:flex;align-items:center;gap:.4rem;cursor:pointer;">
                            <input type="checkbox" class="lich-hoc-check" value="@item.Item1"
                                   @(lichHocHienTai.Contains(item.Item1) ? "checked" : "") />
                            <span>@item.Item2</span>
                        </label>
                    }
                </div>
                <input asp-for="LichHoc" id="lichHocInput" type="hidden" />
            </div>

            <div class="form-row-3">
                <div class="form-group">
                    <label class="form-label">Ngày bắt đầu</label>
                    <input asp-for="NgayBatDau" id="ngayBDInput" type="date" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Ngày kết thúc <small class="text-muted">(tự tính)</small></label>
                    <input asp-for="NgayKetThuc" id="ngayKTInput" type="date" class="form-control" readonly />
                    <div class="meta-hint" id="ngayKetThucInfo">Ngày kết thúc sẽ được tự tính lại theo lịch học và số buổi hiện tại.</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Số buổi dự kiến <small class="text-muted">(đồng bộ từ gói học phí nếu có)</small></label>
                    <input asp-for="SoBuoiDuKien" id="soBuoiInput" type="number" class="form-control" min="1" />
                    <div class="meta-hint" id="sbdInfo"></div>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Sĩ số tối đa</label>
                    <input asp-for="SoHocVienToiDa" id="soHocInput" type="number" class="form-control" min="1" />
                    <div class="meta-hint" id="siSoRuleInfo">Sĩ số phải nhỏ hơn sức chứa phòng học.</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Đơn giá dạy / buổi (đ)</label>
                    <input asp-for="DonGiaDay" type="number" class="form-control" min="0" />
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline"><i class="bi bi-arrow-left"></i> Quay lại</a>
                <a asp-action="Detail" asp-route-id="@Model.LopHocId" class="btn btn-outline">
                    <i class="bi bi-eye"></i> Xem chi tiết
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy2"></i> Lưu thay đổi
                </button>
            </div>
            </div>
        </form>
        </div>
    </div>
    </div>

    <aside class="class-side">
        <div class="class-hero sticky">
            <div class="hero-grid">
                <div class="hero-item">
                    <div class="hero-label">Mã lớp</div>
                    <div class="hero-value">@(!string.IsNullOrWhiteSpace(Model.MaLopHoc) ? Model.MaLopHoc : "Chưa có mã")</div>
                </div>
                <div class="hero-item">
                    <div class="hero-label">Trạng thái</div>
                    <div class="hero-value">@Model.TrangThaiText</div>
                </div>
                <div class="hero-item">
                    <div class="hero-label">Thời gian</div>
                    <div class="hero-value">@(Model.NgayBatDau?.ToString("dd/MM/yyyy") ?? "--") → @(Model.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "--")</div>
                </div>
                <div class="hero-item">
                    <div class="hero-label">Sĩ số thiết kế</div>
                    <div class="hero-value" id="previewSiSoEdit">@(Model.SoHocVienToiDa?.ToString() ?? "Chưa nhập")</div>
                </div>
            </div>
            <div class="hero-actions">
                <button type="submit" form="editForm" class="btn btn-primary"><i class="bi bi-floppy2"></i> Lưu thay đổi</button>
                <a asp-action="Detail" asp-route-id="@Model.LopHocId" class="btn btn-outline"><i class="bi bi-binoculars"></i> Theo dõi lớp</a>
            </div>
        </div>

        <div class="status-panel">
            <h6>Trạng thái hiện tại:
                <span class="badge @Model.TrangThaiBadgeClass">@Model.TrangThaiText</span>
            </h6>
            @if (buocHopLe.Any())
            {
                <div class="status-actions">
                    <span style="font-size:.875rem;color:#6b7280;align-self:center;">Chuyển sang:</span>
                    @foreach (var step in buocHopLe)
                    {
                        <form method="post" asp-action="changestatus"
                              onsubmit="return confirm('Xác nhận chuyển sang «@step.Item2»?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.LopHocId" />
                            <input type="hidden" name="trangThaiMoi" value="@step.Item1" />
                            <input type="hidden" name="returnUrl" value="/Admin/Classes/Edit/@Model.LopHocId" />
                            <button type="submit" class="btn @step.Item3 btn-sm">@step.Item2</button>
                        </form>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0" style="font-size:.875rem;">Không thể chuyển trạng thái từ trạng thái này.</p>
            }
        </div>
    </aside>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const editForm = document.getElementById('editForm');
        const checks = document.querySelectorAll('.lich-hoc-check');
        const lichHocInput = document.getElementById('lichHocInput');
        const khoaHocSelect = document.getElementById('khoaHocSelect');
        const hocPhiSelect = document.getElementById('hocPhiSelect');
        const hocPhiInfo = document.getElementById('hocPhiInfo');
        const tinhThanhSelect = document.getElementById('tinhThanhSelect');
        const phuongXaSelect = document.getElementById('phuongXaSelect');
        const coSoSelect = document.getElementById('coSoSelect');
        const coSoDiaChi = document.getElementById('coSoDiaChi');
        const phongHocSelect = document.getElementById('phongHocSelect');
        const phongCapacityInfo = document.getElementById('phongCapacityInfo');
        const ngayBDInput = document.getElementById('ngayBDInput');
        const ngayKTInput = document.getElementById('ngayKTInput');
        const ngayKetThucInfo = document.getElementById('ngayKetThucInfo');
        const soBuoiInput = document.getElementById('soBuoiInput');
        const sbdInfo = document.getElementById('sbdInfo');
        const soHocInput = document.getElementById('soHocInput');
        const giaoVienSelect = document.getElementById('giaoVienSelect');
        const giaoVienScopeInfo = document.getElementById('giaoVienScopeInfo');
        const previewSiSoEdit = document.getElementById('previewSiSoEdit');
        const DOW_MAP = { '2':1, '3':2, '4':3, '5':4, '6':5, '7':6, 'CN':0 };

        function updateLichHoc() {
            lichHocInput.value = [...checks].filter(c => c.checked).map(c => c.value).join(',');
        }

        function toInputDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function getSoBuoiTarget() {
            const selected = hocPhiSelect.selectedOptions[0];
            const soBuoiGoi = Number(selected?.dataset?.soBuoi || 0);
            const soBuoiNhap = Number(soBuoiInput.value || 0);
            return soBuoiGoi > 0 ? soBuoiGoi : soBuoiNhap;
        }

        function tinhNgayKetThuc() {
            const startValue = ngayBDInput.value;
            const lichHoc = [...checks].filter(c => c.checked).map(c => c.value);
            const soBuoi = getSoBuoiTarget();

            if (!startValue || lichHoc.length === 0 || soBuoi <= 0) {
                ngayKTInput.value = '';
                sbdInfo.textContent = '';
                ngayKetThucInfo.textContent = 'Ngày kết thúc sẽ được tự tính lại theo lịch học và số buổi hiện tại.';
                return;
            }

            const days = new Set(lichHoc.map(x => DOW_MAP[x]));
            const current = new Date(`${startValue}T00:00:00`);
            let daTinh = 0;
            let lastDate = null;

            while (daTinh < soBuoi) {
                if (days.has(current.getDay())) {
                    daTinh++;
                    lastDate = new Date(current);
                }
                current.setDate(current.getDate() + 1);
            }

            if (!lastDate) {
                ngayKTInput.value = '';
                sbdInfo.textContent = '';
                ngayKetThucInfo.textContent = 'Không thể tính ngày kết thúc với lịch học hiện tại.';
                return;
            }

            ngayKTInput.value = toInputDate(lastDate);
            sbdInfo.textContent = hocPhiSelect.value
                ? `Đồng bộ ${soBuoi} buổi từ gói học phí và tự tính lịch kết thúc.`
                : `Tự tính lịch kết thúc theo ${soBuoi} buổi đang cấu hình.`;
            ngayKetThucInfo.textContent = `Kết thúc dự kiến vào ${lastDate.toLocaleDateString('vi-VN')}.`;
        }

        function updatePhongCapacityInfo() {
            const selected = phongHocSelect.selectedOptions[0];
            const sucChua = Number(selected?.dataset?.succhua || 0);
            if (!sucChua) {
                phongCapacityInfo.textContent = '';
                soHocInput.removeAttribute('max');
                return;
            }

            phongCapacityInfo.textContent = `Phòng tối đa ${sucChua} học viên. Sĩ số lớp phải nhỏ hơn ${sucChua}.`;
            if (sucChua > 1) soHocInput.max = String(sucChua - 1);
        }

        async function loadPhuongXa(tinhThanhId, selectedWard = '') {
            phuongXaSelect.innerHTML = '<option value="">-- Đang tải phường/xã... --</option>';
            phuongXaSelect.disabled = true;

            try {
                const query = new URLSearchParams({
                    tinhThanhId: tinhThanhId || '',
                    baoGomPhuongXa: selectedWard || ''
                });
                const res = await fetch(`/Admin/Classes/PhuongXaByTinh?${query.toString()}`);
                if (!res.ok) throw new Error();

                const data = await res.json();
                phuongXaSelect.innerHTML = '<option value="">-- Tất cả địa bàn --</option>';
                data.forEach(w => {
                    const selected = selectedWard && w.name === selectedWard ? ' selected' : '';
                    phuongXaSelect.innerHTML += `<option value="${w.name}"${selected}>${w.name}</option>`;
                });

                if (data.length === 0) {
                    phuongXaSelect.innerHTML = '<option value="">Chưa có dữ liệu phường/xã</option>';
                } else {
                    phuongXaSelect.disabled = false;
                }
            } catch {
                phuongXaSelect.innerHTML = '<option value="">Không tải được phường/xã từ API</option>';
            }
        }

        async function loadCoSoByDiaBan(tinhThanhId, phuongXa, selectedCoSoId = '') {
            if (!tinhThanhId) {
                coSoSelect.innerHTML = '<option value="">-- Chọn tỉnh/thành trước --</option>';
                coSoSelect.disabled = true;
                coSoDiaChi.textContent = '';
                return;
            }

            const query = new URLSearchParams({
                tinhThanhId: tinhThanhId || '',
                phuongXa: phuongXa || '',
                baoGomCoSoId: selectedCoSoId || ''
            });

            const res = await fetch(`/Admin/Classes/CoSoByTinh?${query.toString()}`);
            const data = await res.json();

            coSoSelect.innerHTML = '<option value="">-- Chọn cơ sở đào tạo --</option>';
            data.forEach(c => {
                const selected = selectedCoSoId && String(c.id) === String(selectedCoSoId) ? ' selected' : '';
                const px = c.phuongXa ? ` - ${c.phuongXa}` : '';
                coSoSelect.innerHTML += `<option value="${c.id}" data-diachi="${c.diaChi ?? ''}"${selected}>${c.name}${px}</option>`;
            });

            coSoSelect.disabled = data.length === 0;
            if (data.length === 0) {
                coSoSelect.innerHTML = '<option value="">Không có cơ sở phù hợp</option>';
            }

            coSoDiaChi.textContent = coSoSelect.selectedOptions[0]?.dataset?.diachi
                ? `Địa chỉ: ${coSoSelect.selectedOptions[0].dataset.diachi}`
                : '';
        }

        async function loadHocPhi(khoaHocId, selectedHocPhiId = '') {
            if (!khoaHocId) {
                hocPhiSelect.innerHTML = '<option value="">-- Chọn khóa học trước --</option>';
                soBuoiInput.readOnly = false;
                updateHocPhiInfo();
                return;
            }

            const res = await fetch(`/Admin/Classes/HocPhiByKhoaHoc?khoaHocId=${khoaHocId || ''}`);
            const data = await res.json();
            hocPhiSelect.innerHTML = '<option value="">-- Chọn gói học phí --</option>';
            data.forEach(h => {
                const selected = selectedHocPhiId && String(h.id) === String(selectedHocPhiId) ? ' selected' : '';
                hocPhiSelect.innerHTML += `<option value="${h.id}" data-so-buoi="${h.soBuoi ?? ''}" data-tong-tien="${h.tongHocPhiText ?? ''}"${selected}>${h.name}</option>`;
            });
            updateHocPhiInfo();
        }

        function updateHocPhiInfo() {
            const selected = hocPhiSelect.selectedOptions[0];
            const soBuoi = Number(selected?.dataset?.soBuoi || 0);
            const tongTien = selected?.dataset?.tongTien || '';

            if (!selected || !selected.value || !soBuoi) {
                soBuoiInput.readOnly = false;
                hocPhiInfo.textContent = '';
                tinhNgayKetThuc();
                return;
            }

            soBuoiInput.readOnly = true;
            soBuoiInput.value = soBuoi;
            hocPhiInfo.textContent = tongTien
                ? `Đồng bộ ${soBuoi} buổi từ gói học phí. Tổng học phí tham chiếu: ${tongTien} đ.`
                : `Đồng bộ ${soBuoi} buổi từ gói học phí đã chọn.`;
            tinhNgayKetThuc();
        }

        function refreshGiaoVienLabels() {
            const coSoDangChon = coSoSelect.value;
            [...giaoVienSelect.options].forEach(opt => {
                if (!opt.value) return;
                const baseLabel = opt.dataset.baseLabel || opt.text;
                const coSoId = opt.dataset.cosoId || '';
                const coSoName = opt.dataset.cosoName || 'Chưa gán cơ sở';
                const scope = !coSoDangChon || !coSoId
                    ? 'Chưa xác định'
                    : (coSoId === coSoDangChon ? 'Cùng cơ sở' : 'Khác cơ sở');
                opt.text = `${baseLabel} - ${coSoName} (${scope})`;
            });

            const selected = giaoVienSelect.selectedOptions[0];
            if (!selected || !selected.value) {
                giaoVienScopeInfo.textContent = '';
                return;
            }

            const coSoId = selected.dataset.cosoId || '';
            const coSoName = selected.dataset.cosoName || 'Chưa gán cơ sở';
            if (!coSoSelect.value || !coSoId) {
                giaoVienScopeInfo.textContent = `Giáo viên thuộc: ${coSoName}.`;
                return;
            }

            giaoVienScopeInfo.textContent = coSoId === coSoSelect.value
                ? `Giáo viên cùng cơ sở: ${coSoName}.`
                : `Giáo viên khác cơ sở: ${coSoName} (vẫn được phân công).`;
        }

        checks.forEach(c => c.addEventListener('change', () => {
            updateLichHoc();
            tinhNgayKetThuc();
        }));
        updateLichHoc();
        soHocInput.addEventListener('input', () => {
            previewSiSoEdit.textContent = soHocInput.value?.trim()
                ? `${soHocInput.value.trim()} học viên`
                : 'Chưa nhập';
        });
        hocPhiSelect.addEventListener('change', updateHocPhiInfo);
        ngayBDInput.addEventListener('change', tinhNgayKetThuc);
        soBuoiInput.addEventListener('input', () => {
            if (!hocPhiSelect.value) {
                tinhNgayKetThuc();
            }
        });
        khoaHocSelect.addEventListener('change', async () => {
            await loadHocPhi(khoaHocSelect.value, '');
        });
        tinhThanhSelect.addEventListener('change', async () => {
            const selectedWard = '';
            const selectedCoSoId = '';

            phongHocSelect.innerHTML = '<option value="">-- Chọn cơ sở trước --</option>';
            phongHocSelect.disabled = true;
            phongCapacityInfo.textContent = '';

            if (!tinhThanhSelect.value) {
                phuongXaSelect.innerHTML = '<option value="">-- Chọn tỉnh/thành trước --</option>';
                phuongXaSelect.disabled = true;
                await loadCoSoByDiaBan('', '', '');
                refreshGiaoVienLabels();
                return;
            }

            await loadPhuongXa(tinhThanhSelect.value, selectedWard);
            await loadCoSoByDiaBan(tinhThanhSelect.value, selectedWard, selectedCoSoId);
            refreshGiaoVienLabels();
        });
        phuongXaSelect.addEventListener('change', async () => {
            await loadCoSoByDiaBan(tinhThanhSelect.value, phuongXaSelect.value, '');
            phongHocSelect.innerHTML = '<option value="">-- Chọn cơ sở trước --</option>';
            phongHocSelect.disabled = true;
            phongCapacityInfo.textContent = '';
            refreshGiaoVienLabels();
        });

        if (coSoSelect) {
            coSoSelect.addEventListener('change', async () => {
                coSoDiaChi.textContent = coSoSelect.selectedOptions[0]?.dataset?.diachi
                    ? `Địa chỉ: ${coSoSelect.selectedOptions[0].dataset.diachi}`
                    : '';
                const res = await fetch(`/Admin/Classes/PhongHocByCoso?coSoId=${coSoSelect.value}`);
                const data = await res.json();
                phongHocSelect.innerHTML = '<option value="">-- Chọn phòng học --</option>';
                data.forEach(p => {
                    const sucChuaText = p.sucChua ? ` (Sức chứa ${p.sucChua})` : '';
                    phongHocSelect.innerHTML += `<option value="${p.id}" data-succhua="${p.sucChua ?? ''}">${p.name}${sucChuaText}</option>`;
                });
                refreshGiaoVienLabels();
                updatePhongCapacityInfo();
            });
        }

        phongHocSelect.addEventListener('change', updatePhongCapacityInfo);
        giaoVienSelect.addEventListener('change', refreshGiaoVienLabels);
        updatePhongCapacityInfo();
        updateHocPhiInfo();
        refreshGiaoVienLabels();
        tinhNgayKetThuc();
        coSoDiaChi.textContent = coSoSelect.selectedOptions[0]?.dataset?.diachi
            ? `Địa chỉ: ${coSoSelect.selectedOptions[0].dataset.diachi}`
            : '';
        previewSiSoEdit.textContent = soHocInput.value?.trim()
            ? `${soHocInput.value.trim()} học viên`
            : 'Chưa nhập';

        if (tinhThanhSelect.value) {
            loadPhuongXa(tinhThanhSelect.value, phuongXaSelect.dataset.selected || phuongXaSelect.value)
                .then(() => loadCoSoByDiaBan(tinhThanhSelect.value, phuongXaSelect.dataset.selected || phuongXaSelect.value, coSoSelect.value));
        }

        editForm.addEventListener('submit', (event) => {
            const selectedPhong = phongHocSelect.selectedOptions[0];
            const sucChua = Number(selectedPhong?.dataset?.succhua || 0);
            const siSo = Number(soHocInput.value || 0);
            const selectedHocPhi = hocPhiSelect.selectedOptions[0];
            const soBuoiGoiHocPhi = Number(selectedHocPhi?.dataset?.soBuoi || 0);
            const soBuoiDuKien = Number(soBuoiInput.value || 0);
            if (sucChua > 0 && siSo > 0 && siSo >= sucChua) {
                event.preventDefault();
                phongCapacityInfo.textContent = `Sĩ số ${siSo} không hợp lệ. Phải nhỏ hơn sức chứa ${sucChua}.`;
                soHocInput.focus();
                return;
            }

            if (selectedHocPhi?.value && soBuoiGoiHocPhi > 0 && soBuoiDuKien > 0 && soBuoiDuKien !== soBuoiGoiHocPhi) {
                event.preventDefault();
                hocPhiInfo.textContent = `Số buổi dự kiến phải khớp gói học phí đã chọn (${soBuoiGoiHocPhi} buổi).`;
                soBuoiInput.focus();
                return;
            }

            if (selectedHocPhi?.value && !ngayKTInput.value) {
                event.preventDefault();
                ngayKetThucInfo.textContent = 'Không thể lưu vì chưa đủ dữ liệu để tự tính ngày kết thúc.';
                ngayBDInput.focus();
            }
        });
    </script>
}
