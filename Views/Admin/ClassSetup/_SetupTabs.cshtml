@{
    var current = ViewData["SetupSection"]?.ToString() ?? "Index";
}

<nav class="setup-nav">
    <a asp-action="Index" class="setup-nav-link @(current == "Index" ? "active" : "")">
        <i class="bi bi-grid-1x2"></i> Tổng quan
    </a>
    <a asp-action="CaHoc" class="setup-nav-link @(current == "CaHoc" ? "active" : "")">
        <i class="bi bi-clock-history"></i> Ca học
    </a>
    <a asp-action="HocPhi" class="setup-nav-link @(current == "HocPhi" ? "active" : "")">
        <i class="bi bi-cash-coin"></i> Gói học phí
    </a>
</nav>
